{
  "schemaVersion": "1.0.0",
  "project": "behavior-radial-prototype",
  "description": "Structured behavior model for a split radial menu. Left side logs concerns. Right side logs recovery/expected behavior. Center click opens categories; category click opens behaviors.",
  "uiModel": {
    "interactionPattern": "two_step_split_radial",
    "centerTrigger": {
      "label": "Behavior",
      "icon": "fa-solid fa-bullseye",
      "opens": "category_ring"
    },
    "ringOrder": [
      "category_ring",
      "behavior_ring"
    ],
    "categoryRing": {
      "leftSide": {
        "modeId": "concern",
        "label": "Concern",
        "description": "Use when a student demonstrates a behavior that needs correction.",
        "accentToken": "warning"
      },
      "rightSide": {
        "modeId": "recovery",
        "label": "Recovery",
        "description": "Use when a student corrects behavior, complies, resets, or demonstrates the expected behavior after redirection.",
        "accentToken": "info"
      }
    },
    "behaviorRing": {
      "description": "Second ring shows behaviors belonging to the selected category and mode."
    }
  },
  "loggingModel": {
    "eventTypes": [
      "concern",
      "recovery"
    ],
    "defaultScoreBehavior": {
      "concern": -1,
      "recovery": 1
    },
    "requiredFields": [
      "studentId",
      "studentName",
      "periodId",
      "seatId",
      "modeId",
      "categoryId",
      "behaviorId",
      "timestamp"
    ],
    "optionalFields": [
      "teacherId",
      "teacherName",
      "tableId",
      "zone",
      "position",
      "note",
      "severity",
      "source"
    ]
  },
